# Large RPM binaries live in Git LFS so any size works (GitHub rejects plain
# git blobs over 100MB). Repodata, the .repo file, and VERSION/BUILD_ID stay
# in regular git.
# NOTE: only github.com .../raw/... URLs resolve LFS to real binaries;
# raw.githubusercontent.com and Pages serve the pointer file instead, so the
# dnf baseurl must use the github.com raw form.
repo/*.rpm filter=lfs diff=lfs merge=lfs -text
