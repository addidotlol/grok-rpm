# Large RPM binaries live in Git LFS so they bypass GitHub's 100MB blob
# limit. Repodata, the .repo file, and VERSION/BUILD_ID stay in regular git.
# NOTE: GitHub Pages serves LFS pointer files, not binaries, so the dnf
# baseurl must point at raw.githubusercontent.com (which resolves LFS).
repo/*.rpm filter=lfs diff=lfs merge=lfs -text
